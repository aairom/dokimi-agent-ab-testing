# Dokimi Agent A/B Testing Environment Configuration
# Copy this file to .env and configure as needed.

# Application Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM Provider Configuration
# Supported providers: mock, openai, anthropic, openrouter, local-ollama, local-llamacpp
DEFAULT_LLM_PROVIDER=local-ollama
DEFAULT_LLM_MODEL=llama3.2:latest

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=

# OpenRouter Configuration (Optional)
OPENROUTER_API_KEY=

# Local LLM Configuration (Ollama / Llama.cpp)
# Ollama OpenAI-compatible endpoint: http://localhost:11434/v1
# Ollama native API: http://localhost:11434
OLLAMA_API_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Llama.cpp base URL: http://localhost:8080 or http://localhost:9931
LLAMACPP_API_URL=http://localhost:8080
LLAMACPP_BASE_URL=http://localhost:8080
LOCAL_LLM_BASE_URL=http://localhost:9931/v1

# Model Discovery Timeout and Retries
MODEL_DISCOVERY_TIMEOUT=5.0
MODEL_DISCOVERY_RETRIES=3

# Feature Flags
ALLOW_ADHOC_USECASES=true

# Storage Paths
INPUT_DIR=input
OUTPUT_DIR=output
DATA_DIR=data
